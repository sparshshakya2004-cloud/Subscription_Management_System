# Database Configuration (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=brightloop_subscription

# JWT Configuration
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# SMTP Email Configuration (Leave empty for development logging mode)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=secret_password
FROM_EMAIL=no-reply@brightloop.com
